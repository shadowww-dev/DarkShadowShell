#!/usr/bin/env python3
"""rice-update: updates for DarkShadow's Shell.

  rice-update               install the newest version (runs ./install.sh --update in the repo)
  rice-update check [--json] [--offline]
                            compare your version with the newest one on GitHub
  rice-update watch [on|off|state]  background: checks after login and once a day, shows a notification; off: no checks
                            (how often: every_minutes in ~/.config/rice/update.json, 60 - 10080)
  rice-update notify        show the "Update is Available!" notification now (to try it)
  rice-update update        the one update both Settings > Update Center and the About tab run: the shell, and the
                            system's packages (Arch, Fedora, Gentoo, Flatpak, Snap ...) in a terminal when any
                            wait (the password belongs there). AUR is not updated here: install.sh upgrades only
                            what the shell needs
  rice-update gui           update in the background for Settings > Update Center (no terminal): the steps go to
                            ~/.cache/rice/update-live.log, the state to ~/.cache/rice/update-live.json
  rice-update whatsnew [VERSION]   JSON: what is new in this version (or VERSION), from the CHANGELOG
                            ("show": true the first time Settings opens after an update)
  rice-update whatsnew-seen        Settings showed it: not again for this version
"""
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
DIR = HOME + "/.config/rice"
INSTALLED = DIR + "/version"
CACHE = HOME + "/.cache/rice"
STATE = CACHE + "/update.json"
NOTIFIED = CACHE + "/update-notified"
LIVE_LOG = CACHE + "/update-live.log"
LIVE = CACHE + "/update-live.json"
RAW = "https://raw.githubusercontent.com/shadowww-dev/DarkShadowShell/main/VERSION"
FIRST_WAIT = 45            # seconds after login
UPDATE_CFG = DIR + "/update.json"
DEFAULTS = {"watch": True, "every_minutes": 1440}   # one ask a day: enough for updates, a smaller trail at GitHub
TICK = 30                  # a check from the About tab of the dashboard is noticed within this many seconds
APP = "DarkShadow's Shell"
ICON = HOME + "/.local/share/rice/icon.png"


def cfg():
    """background checks: on by default (a security fix has to reach people), once a day, and the user decides"""
    c = dict(DEFAULTS)
    try:
        raw = json.load(open(UPDATE_CFG))
        if isinstance(raw, dict):
            c.update({k: raw[k] for k in DEFAULTS if k in raw})
        c["every_minutes"] = max(60, min(10080, int(c["every_minutes"])))
    except Exception:
        pass
    return c


def save_cfg(c):
    os.makedirs(DIR, exist_ok=True)
    tmp = UPDATE_CFG + ".tmp"
    json.dump(c, open(tmp, "w"))
    os.replace(tmp, UPDATE_CFG)


def repo():
    try:
        r = open(DIR + "/repo").read().strip()
        if r and os.path.exists(r + "/install.sh"):
            return r
    except OSError:
        pass
    r = HOME + "/shadows-shell"
    return r if os.path.exists(r + "/install.sh") else None


ZIP_MSG = ("This copy of the shell was downloaded as a ZIP (from a GitHub release), not with git, so it cannot get new "
           "versions. Run rice-update in a terminal: it turns it into a git copy and updates.")


def is_zip(r):
    """a copy without .git (the ZIP of a GitHub release): nothing to pull from, it reinstalled the same old version"""
    return bool(r) and not os.path.isdir(r + "/.git")


def make_git(r):
    """clone the project next to the ZIP copy and put the clone in its place (the ZIP copy is kept, renamed)"""
    if not shutil.which("git"):
        print("git is not installed. Install it (sudo pacman -S git, sudo apt install git ...) and run rice-update again.")
        return None
    target = HOME + "/shadows-shell"
    stamp = time.strftime("%Y%m%d-%H%M%S")
    tmp = target + ".new-" + stamp
    print("Downloading the project with git ...")
    c = subprocess.call(["git", "-c", "credential.helper=", "clone", "--quiet", NEW_URL, tmp],
                        env=dict(os.environ, GIT_TERMINAL_PROMPT="0", GCM_INTERACTIVE="never"))
    if c != 0 or not os.path.exists(tmp + "/install.sh"):
        shutil.rmtree(tmp, ignore_errors=True)
        print("git clone did not work (offline?). Nothing was changed.")
        return None
    if os.path.exists(target):
        os.rename(target, target + ".zip-" + stamp)
        print("Your old copy is kept as " + target + ".zip-" + stamp)
    os.rename(tmp, target)
    os.makedirs(DIR, exist_ok=True)
    open(DIR + "/repo", "w").write(target + "\n")
    print("Done: " + target + " is a git copy now, so updates work from here on.")
    return target


def key(v):
    """'2.02' < '2.1' == '2.10' < '3.0' (the part after the dot reads like decimals)"""
    try:
        major, _, minor = v.strip().lstrip("vV").partition(".")
        return (int(major), float("0." + (minor or "0")))
    except ValueError:
        return (0, 0.0)


def clean(v):
    v = (v or "").strip().lstrip("vV")
    return v if v and key(v) > (0, 0.0) else ""


def installed():
    try:
        return clean(open(INSTALLED).read()) or "2.01"
    except OSError:
        return "2.01"   # installs from before versions existed


def git(r, *a, timeout=25):
    # never a login window: no prompt, and no credential helper (a helper like Git Credential Manager opened a GitHub
    # sign-in window during updates; the shell is public, reading it needs no login)
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GIT_ASKPASS="true", SSH_ASKPASS="true", GCM_INTERACTIVE="never")
    return subprocess.run(["git", "-c", "credential.helper=", "-C", r] + list(a), capture_output=True, text=True,
                          timeout=timeout, env=env)


NEW_URL = "https://github.com/shadowww-dev/DarkShadowShell.git"


# the installer's rule (install/lib/secure.sh update_remote_ok): an update may only come from this project, or a
# fork of it, never from an address edited into the repo
REPO_ORIGIN = re.compile(r"^(https://|git@|ssh://(git@)?)(www\.)?github\.com[:/][^/]+/DarkShadowShell(\.git)?/?$")


def origin_ok(r):
    try:
        u = git(r, "remote", "get-url", "origin", timeout=5).stdout.strip()
    except Exception:
        return False
    return bool(REPO_ORIGIN.search(u))


def fix_remote(r):
    """the project moved (shadows-shell -> DarkShadowShell): an old address goes to the new one, before GitHub's
    redirect is the thing that asks for a login"""
    try:
        u = git(r, "remote", "get-url", "origin", timeout=5).stdout.strip()
        if "shadowww-dev/shadows-shell" in u:
            git(r, "remote", "set-url", "origin", NEW_URL, timeout=5)
    except Exception:
        pass


def news(text, version):
    """first lines of the CHANGELOG entry for this version"""
    out, on = [], False
    for ln in (text or "").splitlines():
        h = ln.strip()
        if h.startswith("## "):
            if on:
                break
            on = h[3:].strip().lstrip("vV").startswith(version)
            continue
        if on and h.startswith(("- ", "* ")):
            out.append(h[2:].strip())
    return out


def latest(offline=False):
    """newest version: GitHub (through your repo's git remote), else the raw file, else your repo.
    Also: how many new commits GitHub has that this computer does not (an update without a new number)."""
    r = repo()
    found, err = [], ""
    latest.ahead, latest.sha, latest.log = 0, "", ""
    if r and os.path.isdir(r + "/.git") and shutil.which("git"):
        try:
            if not offline:
                fix_remote(r)
            if not offline and origin_ok(r):
                f = git(r, "fetch", "--quiet")
                if f.returncode != 0:
                    err = (f.stderr.strip().splitlines() or ["git fetch failed"])[-1]
            elif not offline:
                err = "the update remote is not this project"
            refs = []
            u = git(r, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}", timeout=5)
            if u.returncode == 0 and u.stdout.strip():
                refs.append(u.stdout.strip())
            refs += ["origin/main", "origin/master"]
            for ref in refs:
                s = git(r, "show", ref + ":VERSION", timeout=5)
                if s.returncode == 0 and clean(s.stdout):
                    found.append(clean(s.stdout))
                    a = git(r, "rev-list", "--count", "HEAD.." + ref, timeout=5)
                    latest.ahead = int(a.stdout.strip() or 0) if a.returncode == 0 else 0
                    h = git(r, "rev-parse", "--short", ref, timeout=5)
                    latest.sha = h.stdout.strip() if h.returncode == 0 else ""
                    cl = git(r, "show", ref + ":CHANGELOG.md", timeout=5)
                    latest.log = cl.stdout if cl.returncode == 0 else ""
                    break
        except Exception as e:
            err = str(e)
    if not found and not offline and shutil.which("curl"):
        try:
            c = subprocess.run(["curl", "-fsSL", "--max-time", "15", RAW], capture_output=True, text=True, timeout=20)
            if c.returncode == 0 and clean(c.stdout):
                found.append(clean(c.stdout))
                err = ""
        except Exception as e:
            err = err or str(e)
    if r:
        try:
            found.append(clean(open(r + "/VERSION").read()))   # pulled but not installed yet
        except OSError:
            pass
        if not latest.log:
            try:
                latest.log = open(r + "/CHANGELOG.md").read()
            except OSError:
                pass
    found = [v for v in found if v]
    return (max(found, key=key) if found else ""), err


def check(offline=False):
    have = installed()
    new, err = latest(offline)
    newer = bool(new) and key(new) > key(have)
    ahead = getattr(latest, "ahead", 0)
    out = {"installed": have, "latest": new or have, "update": newer or ahead > 0,
           "changes": ahead, "commit": getattr(latest, "sha", ""),
           "news": news(getattr(latest, "log", ""), new or have)[:4],
           "checked": int(time.time()),
           # a failed fetch used to be dropped whenever any version was known, so the page showed the last
           # version it had seen (the stale branch) as a fresh answer: "Check for updates" looked dead
           "error": err}
    if is_zip(repo()):
        out["update"] = True
        out["error"] = ZIP_MSG
    os.makedirs(CACHE, exist_ok=True)
    try:
        # V7.00: a reader (the watch loop, the About tab) must never see half a file: the answer goes beside the
        # old one and is swapped in whole, as the other state files here do
        tmp = STATE + ".new"
        json.dump(out, open(tmp, "w"))
        os.replace(tmp, STATE)
    except OSError:
        pass
    return out


def our_update(pid):
    """a live process that is this updater, not a pid number that was reused. A terminal window that waits at
    "Press Enter to close" stays alive after its update finished, so being alive alone proves nothing."""
    if not alive(pid):
        return False
    cmd = None
    try:
        cmd = open("/proc/%d/cmdline" % int(pid), "rb").read().replace(b"\0", b" ").decode("utf-8", "replace")
    except (OSError, ValueError):
        # no /proc (not Linux, or a hidden one): ps knows the command line everywhere else
        try:
            cmd = subprocess.run(["ps", "-p", str(int(pid)), "-o", "args="], capture_output=True, text=True,
                                 timeout=2).stdout
        except Exception:
            return True                # nothing to ask: the old alive check is the best there is
    return "rice-update" in cmd


def terminal_open():
    """is there a terminal with this update in it: its pid in update-terminal.pid, or a fresh marker (gnome-terminal
    hands the window to another process at once). Takes no live state, so live() can ask it without a loop."""
    pidf = CACHE + "/update-terminal.pid"
    try:
        pid = int(open(pidf).read().strip())
        if our_update(pid):
            return True
        os.unlink(pidf)                # a closed window, or a pid that now belongs to something else
    except (OSError, ValueError):
        pass
    # a terminal that hands the window to another process (gnome-terminal) is gone at once: its fresh marker counts
    try:
        return time.time() - os.path.getmtime(CACHE + "/update-terminal") < 90
    except OSError:
        return False


def terminal_active():
    """a terminal opened for the update a moment ago, or one still running it.
    (the terminal that is gone left the live state on "terminal": without this, every later Update did nothing)"""
    # V6.97: the terminal reports when its update ends (RICE_LIVE). The window then stays open at "Press Enter to
    # close", still alive: counting its pid blocked every later Update for as long as that window was open.
    return live().get("state") in ("terminal", "running") and terminal_open()


def terminal_update(extra=None):
    """ONE terminal with rice-update in it (at most one a minute), without the background update's settings: an old
    installer (before V4.56) that saw RICE_GUI in its terminal opened another terminal instead of asking, endlessly"""
    mark = CACHE + "/update-terminal"
    st = live()
    if st.get("state") == "running" and our_update(st.get("pid")):
        # the update itself is running (opened in a terminal, or the quiet one): do not open a second
        return True
    if terminal_active():
        # a terminal for this same update opened a moment ago: that one is this update, not a failure
        return True
    os.makedirs(CACHE, exist_ok=True)
    # V6.97: the marker and then the state are set before the window opens, so a second click in the same moment does
    # not open another, and the caller does not overwrite the "running" the new terminal reports a moment later
    open(mark, "w").write(str(int(time.time())))
    put_live(state="terminal", code=-1, started=int(time.time()), ended=0, pid=0, was=installed())
    env = dict(os.environ)
    for k in ("RICE_GUI", "NO_COLOR", "GIT_TERMINAL_PROMPT", "GCM_INTERACTIVE"):
        env.pop(k, None)
    # the terminal's rice-update reports running / done, so Settings follows it instead of showing a failure
    env["RICE_LIVE"] = "1"
    t = os.environ.get("TERMINAL") or "kitty"
    if not shutil.which(t):
        t = next((x for x in ("kitty", "foot", "alacritty", "wezterm", "konsole", "gnome-terminal") if shutil.which(x)), t)
    # V6.99: your terminal first, then the one found, so a configured terminal that cannot start (a missing
    # display, an unknown flag) still gets a window instead of looking like a dead Update now
    # V7.00: flags like --no-upgrade travel with the terminal (rice-update with no command passes them to install.sh)
    tail = [HOME + "/.local/bin/rice-update"] + list(extra or [])
    tries = []
    if os.access(HOME + "/.local/bin/rice-term", os.X_OK):
        tries.append([HOME + "/.local/bin/rice-term", "-e"] + tail)
    if [t, "-e"] + tail not in tries:
        tries.append([t, "-e"] + tail)
    for cmd in tries:
        try:
            p = subprocess.Popen(cmd, start_new_session=True, env=env,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            continue
        time.sleep(0.25)
        # a window that is gone at once failed (no display, a bad flag); one that exited 0 handed its window on
        if getattr(p, "poll", lambda: None)() not in (None, 0):
            continue
        try:
            open(CACHE + "/update-terminal.pid", "w").write(str(p.pid))
        except OSError:
            pass
        return True
    try:
        os.unlink(mark)                # nothing will report running: do not leave a false "terminal" for 90 s
    except OSError:
        pass
    return False


def installer_changes(r):
    """does the newest version change the installer (install.sh, install/lib)? Then the update must be asked about in a
    terminal. Checked here, before the installer runs: an installer from before V4.56 got this wrong from Settings and
    opened terminals without end"""
    q = dict(cwd=r, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
             env=dict(os.environ, GIT_TERMINAL_PROMPT="0", GCM_INTERACTIVE="never"))
    try:
        fix_remote(r)
        if not origin_ok(r):
            return False
        if subprocess.call(["git", "-c", "credential.helper=", "fetch", "--quiet", "origin"], timeout=60, **q) != 0:
            return False
        up = subprocess.run(["git", "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}"], cwd=r,
                            capture_output=True, text=True).stdout.strip() or "origin/main"
        return subprocess.call(["git", "diff", "--quiet", "HEAD", up, "--", "install.sh", "install/lib",
                                "install/patches", "bin"], timeout=30, **q) == 1
    except Exception:
        return False


def open_center():
    """Settings > Update Center (the update runs there, with its steps shown live); a terminal without Settings"""
    rs = HOME + "/.local/bin/rice-settings"
    if os.access(rs, os.X_OK):
        subprocess.Popen([rs, "35"], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        terminal_update()


def live():
    """the update that runs (or ran); V6.98: a state left on "running"/"terminal" by an update that is gone is
    healed to "failed" here. After a killed update or a reboot nothing was alive, but Settings kept its last state:
    "running" disabled Update now and Update Center forever, with no process to find."""
    try:
        st = json.load(open(LIVE))
    except (OSError, ValueError):
        return {}
    if not isinstance(st, dict):
        return {}
    dead = st.get("state") == "running" and not our_update(st.get("pid"))
    if st.get("state") == "terminal" and not terminal_open():
        dead = True
    if dead:
        st = dict(st, state="failed", code=1, ended=int(time.time()) or 1, pid=0)
        try:
            put_live(**st)
        except (OSError, TypeError):
            pass
    return st


def alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def put_live(**kw):
    os.makedirs(CACHE, exist_ok=True)
    tmp = LIVE + ".new"
    with open(tmp, "w") as f:
        json.dump(kw, f)
    os.replace(tmp, LIVE)


def finish(t0, code, was):
    """how an update ends, one copy for the quiet background one and the one in a terminal: what it was, what it
    became, and a fresh version check (offline: the update itself already pulled the newest)"""
    try:
        check(offline=True)
    except Exception:
        pass
    put_live(state="done" if code == 0 else "failed", code=code, started=t0, ended=int(time.time()), pid=0,
             was=was, now=installed())


def gui(args):
    """the update without a terminal: install.sh --update --yes --no-packages, detached from Settings (the update
    puts new Settings files in place, so Settings reloads in the middle; this keeps running and Settings reads on)"""
    os.makedirs(CACHE, exist_ok=True)
    # two clicks (Settings and the Update Center at once) started two installers: one at a time
    lk = open(CACHE + "/update.lock", "w")
    try:
        fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("already updating")
        return 0
    st = live()
    if st.get("state") == "terminal" and terminal_active():
        print("already updating")
        return 0
    if st.get("state") == "running" and our_update(st.get("pid")):
        print("already updating")
        return 0
    r = repo()
    if not r:
        open(LIVE_LOG, "w").write("    \u2718 Could not find your copy of the repo (~/shadows-shell). Clone it again:\n"
                                  "      git clone https://github.com/shadowww-dev/DarkShadowShell ~/shadows-shell\n")
        put_live(state="failed", code=1, started=int(time.time()), ended=int(time.time()), pid=0)
        return 1
    if is_zip(r):
        open(LIVE_LOG, "w").write("    \u2718 " + ZIP_MSG + "\n")
        put_live(state="failed", code=1, started=int(time.time()), ended=int(time.time()), pid=0)
        terminal_update()
        return 1
    if os.fork() != 0:
        return 0
    os.setsid()
    if os.fork() != 0:
        os._exit(0)
    log = open(LIVE_LOG, "w", buffering=1)
    t0 = int(time.time())
    if installer_changes(r):
        log.write("    \u2139 This update changes the installer, so it is asked about in a terminal: one opened now.\n"
                  "      Answer y there (it may ask for your password). Nothing was changed yet.\n")
        if not terminal_update():
            log.write("    \u2718 No terminal could be opened. Run  rice-update  in one to apply it.\n")
            put_live(state="failed", code=1, started=t0, ended=int(time.time()), pid=0, was=installed())
        os._exit(0)
    was = installed()
    put_live(state="running", code=-1, started=t0, ended=0, pid=os.getpid(), was=was)
    env = dict(os.environ, RICE_GUI="1", RICE_UPDATE_LOCK="1", NO_COLOR="1", GIT_TERMINAL_PROMPT="0", GCM_INTERACTIVE="never")
    env.pop("SUDO_ASKPASS", None)
    want = ["--update", "--yes"] + (args if args else ["--no-packages"])
    try:
        code = subprocess.call(["./install.sh"] + want, cwd=r, env=env, stdin=subprocess.DEVNULL,
                               stdout=log, stderr=subprocess.STDOUT)
    except Exception as e:
        log.write("    \u2718 %s\n" % e)
        code = 1
    finish(t0, code, was)
    os._exit(0)


def packages_pending():
    """updates waiting in the system's packages, Flatpak or Snap: those need the password, so they run in a terminal.
    AUR is shown in Settings but never updated here (only the packages the shell itself needs, and install.sh does
    that). The check may take minutes (emerge, dnf): the timeout covers the slowest one."""
    b = HOME + "/.local/bin/rice-care"
    if not os.access(b, os.X_OK):
        return 0
    try:
        r = subprocess.run([b, "updates"], capture_output=True, text=True, timeout=600)
        d = json.loads((r.stdout.strip().splitlines() or ["{}"])[-1])
        if isinstance(d.get("updateable"), int):
            return d["updateable"]
        return sum(int(m.get("count") or 0) for m in d.get("managers") or [] if not m.get("manual"))
    except Exception:
        return 0


def update_all(args):
    """one action for both places that show updates: a terminal when packages wait, else the quiet GUI update.
    V6.99: the places that already know say which (--terminal / --gui), so a click no longer waits for the package
    check first: it can take minutes (checkupdates, flatpak, snap, AUR), and the button looked dead all that time."""
    args = list(args)
    want = "--terminal" if "--terminal" in args else ("--gui" if "--gui" in args else "")
    args = [a for a in args if a not in ("--terminal", "--gui")]
    if want == "--gui":
        return gui(args)
    if want == "--terminal" or packages_pending() > 0:
        if not terminal_update(args):
            # V6.97: no terminal opened: say it failed instead of showing an update in a terminal that is not there
            t0 = int(time.time())
            open(LIVE_LOG, "w").write("    \u2718 No terminal could be opened. Run  rice-update  in one to apply it.\n")
            put_live(state="failed", code=1, started=t0, ended=t0, pid=0, was=installed())
        return 0
    return gui(args)


def body(st):
    v = st["latest"]
    head = "<b>Update V%s</b>" % v
    if st.get("installed") and st["installed"] != v:
        head += "  ·  you have V%s" % st["installed"]
    elif st.get("changes"):
        head += "  ·  %d new change%s" % (st["changes"], "" if st["changes"] == 1 else "s")
    lines = [head]
    for n in (st.get("news") or [])[:3]:
        lines.append("•  " + n.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))
    return "\n".join(lines)


def notify(st):
    """the popup; clicking it (or Update now) opens the update in a terminal"""
    if not shutil.which("notify-send"):
        return
    icon = ICON if os.path.exists(ICON) else "system-software-update"
    try:
        r = subprocess.run(["notify-send", "-a", APP, "-i", icon, "-u", "normal", "-t", "20000",
                            "-c", "system.update",
                            "-A", "default=Update now", "-A", "update=Update now", "-A", "later=Later",
                            "--wait", "Update is Available!", body(st)],
                           # V7.01: a popup nobody answers used to keep this process for six hours
                           capture_output=True, text=True, timeout=600)
        if r.stdout.strip() in ("default", "update"):
            open_center()
    except Exception:
        pass


def notify_bg(st):
    if os.fork() == 0:
        os.setsid()
        notify(st)
        os._exit(0)


def maybe_notify(st):
    """show the popup once per new version / new push"""
    if not st or not st.get("update"):
        return
    try:
        told = open(NOTIFIED).read().strip()
    except OSError:
        told = ""
    tag = "%s %s" % (st.get("latest", ""), st.get("commit", ""))
    if told != tag:
        open(NOTIFIED, "w").write(tag)
        notify_bg(st)


def mtime(p):
    try:
        return os.path.getmtime(p)
    except OSError:
        return 0


def last_checked():
    """when the last check ran, kept across restarts: a shell that restarts (an update, a reload) used to check
    again 45 s later, so every push gave a new "Update is Available" within a minute"""
    try:
        return min(time.time(), float(json.load(open(STATE)).get("checked") or 0))
    except (OSError, ValueError, TypeError):
        return 0.0


def watch():
    c = cfg()
    if c.get("watch") is False:
        return
    every = int(c["every_minutes"]) * 60
    os.makedirs(CACHE, exist_ok=True)
    lk = open(CACHE + "/update-watch.lock", "w")
    try:
        fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # already running
    time.sleep(FIRST_WAIT)
    last, seen = last_checked(), mtime(STATE)
    while True:
        # Settings > Language & region > Check for updates is read again every tick: off stops this one at once
        c = cfg()
        if c.get("watch") is False:
            return
        every = int(c["every_minutes"]) * 60
        try:
            if time.time() - last >= every:
                last = time.time()
                st = check()
                seen = mtime(STATE)
                maybe_notify(st)
            else:
                # the About tab of the dashboard (or rice-update check) found something: tell right away
                m = mtime(STATE)
                if m and m != seen:
                    seen = m
                    st = json.load(open(STATE))
                    last = max(last, float(st.get("checked") or 0))
                    maybe_notify(st)
        except Exception:
            pass
        time.sleep(TICK)


def run(args):
    r = repo()
    if not r:
        print("Could not find your copy of the repo. Clone it again:")
        print("  git clone https://github.com/shadowww-dev/DarkShadowShell ~/shadows-shell")
        input("Press Enter to close")
        sys.exit(1)
    if is_zip(r):
        print(ZIP_MSG.replace(" Run rice-update in a terminal: it turns", " This turns"))
        try:
            a = input("Make it a git copy now? [Y/n] ").strip().lower()
        except EOFError:
            a = "y"
        r = make_git(r) if a in ("", "y", "yes") else None
        if not r:
            try:
                input("Press Enter to close")
            except EOFError:
                pass
            sys.exit(1)
    os.chdir(r)
    env = dict(os.environ)
    for k in ("RICE_GUI", "NO_COLOR", "GIT_TERMINAL_PROMPT", "GCM_INTERACTIVE"):
        env.pop(k, None)   # a terminal the Update Center opened must ask, not act like the background update
    live_run = os.environ.get("RICE_LIVE") == "1"
    env.pop("RICE_LIVE", None)
    t0 = int(time.time())
    was = installed()
    if live_run:
        put_live(state="running", code=-1, started=t0, ended=0, pid=os.getpid(), was=was)
    code = subprocess.call(["./install.sh", "--update"] + args, env=env)
    if live_run:
        finish(t0, code, was)
    print()
    try:
        input("Press Enter to close")
    except EOFError:
        pass
    sys.exit(code)


# ---------------- V5.03: what is new ----------------
SEEN = DIR + "/whatsnew-seen"


def md_line(t):
    """a CHANGELOG line for Settings (Qt's StyledText): **bold**, `code`, the rest escaped"""
    t = t.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    t = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", t)
    return re.sub(r"`(.+?)`", r"<i>\1</i>", t)


def whatsnew(ver=None):
    r = repo()
    text = ""
    for f in ([r + "/CHANGELOG.md"] if r else []) + [HOME + "/.local/share/rice/CHANGELOG.md"]:
        try:
            text = open(f).read()
            break
        except OSError:
            pass
    inst = ""
    try:
        inst = open(INSTALLED).read().strip()
    except OSError:
        pass
    ver = ver or inst
    title, items, found = "", [], False
    for line in text.splitlines():
        m = re.match(r"^##\s+V([\d.]+)\s*:?\s*(.*)$", line)
        if m:
            if found:
                break
            found = m.group(1) == ver
            title = m.group(2).strip() if found else ""
            title = title[:1].upper() + title[1:]
            continue
        if found and line.startswith("- "):
            items.append(md_line(line[2:].strip()))
    try:
        seen = open(SEEN).read().strip()
    except OSError:
        seen = ""
    # the first install: the welcome screen shows the shell, not a changelog; it starts counting from here
    first = not os.path.exists(DIR + "/welcome-seen") and not seen
    if first and inst:
        try:
            open(SEEN, "w").write(inst + "\n")
        except OSError:
            pass
    print(json.dumps({"version": ver, "title": title, "items": items[:16], "more": max(0, len(items) - 16),
                      "show": bool(items) and not first and seen != ver and ver == inst}))


def main(a):
    cmd = a[1] if len(a) > 1 else ""
    if cmd == "whatsnew":
        whatsnew(a[2] if len(a) > 2 else None)
        return
    if cmd == "whatsnew-seen":
        try:
            open(SEEN, "w").write(open(INSTALLED).read().strip() + "\n")
        except OSError:
            pass
        return
    if cmd == "live":
        print(json.dumps(live()))
    elif cmd == "check":
        st = check(offline="--offline" in a)
        if "--json" in a:
            print(json.dumps(st))
        elif st["update"]:
            extra = (" (%d new changes)" % st["changes"]) if st["latest"] == st["installed"] and st["changes"] else ""
            print("Update V%s is available%s (you have V%s). Run: rice-update" % (st["latest"], extra, st["installed"]))
            for n in st["news"]:
                print("  - " + n)
        else:
            print("Up to date: V%s%s" % (st["installed"], ("  (could not check: %s)" % st["error"]) if st["error"] else ""))
    elif cmd == "watch":
        if len(a) > 2 and a[2] == "state":
            c = cfg()
            print(json.dumps({"watch": c.get("watch") is not False, "every_minutes": c["every_minutes"]}))
        elif len(a) > 2 and a[2] in ("on", "off"):
            c = cfg()
            c["watch"] = a[2] == "on"
            save_cfg(c)
            print("Background update checks: " + ("on" if c["watch"] else "off"))
            if c["watch"]:
                subprocess.Popen([sys.executable, os.path.abspath(__file__), "watch"], stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL, start_new_session=True)
        else:
            watch()
    elif cmd == "notify":
        st = check(offline="--offline" in a)
        if not st["news"]:
            st["news"] = ["This is how the update notification looks"]
        notify_bg(st)
    elif cmd == "gui":
        sys.exit(gui(a[2:]))
    elif cmd == "update":
        sys.exit(update_all(a[2:]))
    elif cmd == "center":
        open_center()
    elif cmd in ("", "run"):
        run(a[2:])
    elif cmd in ("-h", "--help", "help"):
        print(__doc__)
    else:
        run(a[1:])   # pass flags like --no-packages on to install.sh


if __name__ == "__main__":
    main(sys.argv)
