#!/usr/bin/env python3
"""rice-care: keeping the computer itself up to date and clean (Settings > System > Care), V6.00 (V6.01).

  rice-care updates [--fresh] JSON: the updates waiting for the system, by package manager (nothing is changed;
                              kept for 10 minutes, --fresh checks again). AUR is shown, never updated here
  rice-care update            the update in a terminal: a snapshot first when snapper or timeshift is there,
                              the mirrors (reflector), then every package manager found (your password is asked
                              there, never here). AUR is left alone: install.sh upgrades only what the shell needs
  rice-care scan              JSON: what can be cleaned and how big it is (nothing is removed)
  rice-care clean ID...       clean those: your own files at once, the system's in a terminal (it asks for your
                              password). IDs: pkgcache orphans journal coredumps aurcache thumbnails trash
  rice-care wait              waits until the terminal of the last update or clean-up is done (Settings then looks
                              again), or was closed

Nothing runs as root without the terminal and your password. Package caches keep the last two versions of every
package, so going back one version still works offline. V6.01: the old package files are worked out here, by name
and version (pacman-contrib is not needed any more), and pacman's own leftover download folders go too (pacman -Sc
stopped on those with "could not open file ... download-XXXX").
"""
import functools
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
BIN = HOME + "/.local/bin/"
CACHE = HOME + "/.cache/rice"
PIDF = CACHE + "/care-run.pid"
PKGLIST = CACHE + "/care-pkgcache.list"


def run(cmd, timeout=90):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout, r.stderr
    except (OSError, subprocess.TimeoutExpired):
        return 1, "", ""


def has(c):
    return shutil.which(c) is not None


def du(path):
    """bytes under a path (what can be read of it)"""
    total = 0
    if os.path.isfile(path):
        try:
            return os.path.getsize(path)
        except OSError:
            return 0
    for root, dirs, files in os.walk(path, onerror=lambda e: None):
        for f in files:
            try:
                st = os.lstat(os.path.join(root, f))
                total += st.st_blocks * 512 if st.st_blocks else st.st_size
            except OSError:
                pass
    return total


def aur_helper():
    for h in ("paru", "yay"):
        if has(h):
            return h
    return ""


# ---------------------------------------------------------------- updates
def pkg_lines(out, parse):
    items = []
    for line in out.splitlines():
        line = line.strip()
        if not line or line.startswith(("::", "Listing", "Last metadata", "WARNING")):
            continue
        it = parse(line)
        if it:
            items.append(it)
    return items


def arrow(line):
    # "name 1.0-1 -> 1.1-1"
    p = line.split()
    if len(p) >= 4 and p[2] == "->":
        return {"name": p[0], "from": p[1], "to": p[3]}
    return {"name": p[0], "from": "", "to": p[1] if len(p) > 1 else ""} if p else None


UPDATES = CACHE + "/updates.json"
UPDATES_KEEP = 600          # seconds: checkupdates and flatpak are slow, and both UIs read the same answer


def updates(fresh=False):
    """the answer is kept for a while: Update Center, About and Care all ask, and checkupdates can take minutes"""
    if not fresh:
        try:
            d = json.load(open(UPDATES))
            if time.time() - d.pop("at", 0) < UPDATES_KEEP:
                print(json.dumps(d))
                return
        except (OSError, ValueError):
            pass
    out = []
    if has("rpm-ostree"):
        # Fedora Atomic (Silverblue, Bazzite): dnf sees the layered packages only; the system comes as an image
        out.append({"id": "ostree", "name": "Fedora Atomic (rpm-ostree)", "items": [],
                    "note": "Layered packages update with sudo rpm-ostree upgrade; a restart puts them on", "manual": True})
    elif has("pacman"):
        if has("checkupdates"):
            code, so, _ = run(["checkupdates"], 120)        # its own copy of the database: safe while you work
            out.append({"id": "pacman", "name": "Arch packages", "items": pkg_lines(so, arrow) if code in (0, 2) else [],
                        "note": "" if code in (0, 2) else "Could not check (no internet?)"})
        else:
            code, so, _ = run(["pacman", "-Qu"], 30)
            out.append({"id": "pacman", "name": "Arch packages", "items": pkg_lines(so, arrow),
                        "note": "From the last sync: install pacman-contrib for a fresh check"})
        h = aur_helper()
        if h:
            code, so, _ = run([h, "-Qua"], 120)
            # shown only: an AUR build is someone else's code, and the update here is the shell's, not the AUR's
            out.append({"id": "aur", "name": "AUR (" + h + ")", "items": pkg_lines(so, arrow),
                        "note": "not updated here, unless the shell needs the package", "manual": True})
    elif has("xbps-install"):
        code, so, _ = run(["xbps-install", "-nuM"], 120)
        out.append({"id": "xbps", "name": "Void packages",
                    "items": pkg_lines(so, lambda l: {"name": l.split()[0], "from": "", "to": ""}), "note": ""})
    elif has("dnf"):
        code, so, _ = run(["dnf", "-q", "check-update"], 180)
        out.append({"id": "dnf", "name": "Fedora packages",
                    "items": pkg_lines(so, lambda l: {"name": l.split()[0], "from": "", "to": l.split()[1] if len(l.split()) > 1 else ""}), "note": ""})
    elif has("emerge"):
        # Gentoo (V6.70): what an update of @world would bring, from the last sync (the check computes, it compiles nothing)
        def ebuild_line(l):
            m = re.match(r'^\[(?:ebuild|binary)[^\]]*\]\s+(\S+?)-(\d\S*?)(?:::\S+)?(?:\s+\[([^\]]+)\])?(?:\s|$)', l)
            return {"name": m.group(1), "from": m.group(3) or "", "to": m.group(2).split(":")[0]} if m else None
        code, so, _ = run(["emerge", "--pretend", "--update", "--deep", "--newuse", "--quiet", "--color=n", "--with-bdeps=n", "@world"], 300)
        out.append({"id": "portage", "name": "Gentoo packages", "items": pkg_lines(so, ebuild_line),
                    "note": "From the last sync: sudo emaint sync -a, then sudo emerge -uDN @world"})
    elif has("apt"):
        code, so, _ = run(["apt", "list", "--upgradable"], 60)
        out.append({"id": "apt", "name": "Debian / Ubuntu packages",
                    "items": pkg_lines(so, lambda l: {"name": l.split("/")[0], "from": "", "to": l.split()[1] if len(l.split()) > 1 else ""}), "note": ""})
    elif has("zypper"):
        code, so, _ = run(["zypper", "-q", "lu"], 120)
        out.append({"id": "zypper", "name": "openSUSE packages",
                    "items": pkg_lines(so, lambda l: {"name": l.split("|")[2].strip(), "from": "", "to": ""} if l.count("|") >= 4 and l[0] in "v ?" else None), "note": ""})
    elif has("nixos-rebuild"):
        # NixOS (the main system): the packages are in configuration.nix, so there is nothing to list or update here
        out.append({"id": "nixos", "name": "NixOS system", "items": [],
                    "note": "Your system updates with sudo nixos-rebuild switch --upgrade; packages stay in configuration.nix",
                    "manual": True})
    if has("flatpak"):
        code, so, _ = run(["flatpak", "remote-ls", "--updates", "--columns=application,version"], 120)
        out.append({"id": "flatpak", "name": "Flatpak apps",
                    "items": pkg_lines(so, lambda l: {"name": l.split()[0], "from": "", "to": l.split()[1] if len(l.split()) > 1 else ""}), "note": ""})
    if has("snap"):
        code, so, _ = run(["snap", "refresh", "--list"], 120)
        out.append({"id": "snap", "name": "Snap apps",
                    "items": pkg_lines(so, lambda l: None if l.split()[0] == "Name" else
                                       {"name": l.split()[0], "from": "", "to": l.split()[1] if len(l.split()) > 1 else ""}), "note": ""})
    for m in out:
        m["count"] = len(m["items"])
        m["items"] = m["items"][:200]
    d = {"managers": out, "total": sum(m["count"] for m in out),
         "updateable": sum(m["count"] for m in out if not m.get("manual")), "snapshot": snapshot_tool()}
    os.makedirs(CACHE, exist_ok=True)
    try:
        tmp = UPDATES + ".new"
        json.dump(dict(d, at=int(time.time())), open(tmp, "w"))
        os.replace(tmp, UPDATES)
    except OSError:
        pass
    print(json.dumps(d))


def snapshot_tool():
    if has("snapper"):
        return "snapper"
    if has("timeshift"):
        return "timeshift"
    return ""


def terminal(script, title):
    """runs a bash script in the user's terminal; it waits for Enter at the end so it can be read"""
    os.makedirs(CACHE, exist_ok=True)
    # V7.00: one file per run. A second clean-up while the first window is still open used to rewrite the script the
    # first bash was still reading, so it could carry on in the middle of the new one and run the wrong command
    f = CACHE + "/care-run-%d.sh" % os.getpid()
    try:
        os.remove(PIDF)
    except OSError:
        pass
    # the pid file is there while it works: Settings (rice-care wait) looks again once it is gone
    open(f, "w").write("#!/usr/bin/env bash\nset -u\nP=\"" + PIDF + "\"\necho $$ > \"$P\"\ntrap 'rm -f \"$P\"' EXIT\n"
                       "B=$'\\e[1m'; G=$'\\e[32m'; Z=$'\\e[0m'\necho \"${B}" + title + "${Z}\"\necho\n" + script
                       + "\nrm -f \"$P\"\necho\necho \"${G}${B}Done.${Z} Press Enter to close.\"\nread -r _\nrm -f \"$0\"\n")
    os.chmod(f, 0o700)
    term = BIN + "rice-term"
    cmd = [term, "--class", "rice-care", "-e", "bash", f] if os.access(term, os.X_OK) else ["kitty", "--class", "rice-care", "bash", f]
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def update():
    s = []
    snap = snapshot_tool()
    if snap == "snapper":
        s.append('echo "A snapshot first (snapper), so this update can be undone:"; sudo snapper -c root create -d "Before an update (DarkShadow)" && echo "  made." || echo "  could not make one: going on."')
    elif snap == "timeshift":
        s.append('echo "A snapshot first (timeshift), so this update can be undone:"; sudo timeshift --create --comments "Before an update (DarkShadow)" --scripted >/dev/null && echo "  made." || echo "  could not make one: going on."')
    if has("pacman"):
        # the mirrors first (reflector), then the repositories. AUR: no. Its builds are the AUR's, and a broken one
        # can take the update with it; the shell upgrades the AUR packages it needs in install.sh --update
        s.append('echo; echo "Mirrors (reflector):"; "' + BIN + 'rice-mirrors" || echo "  kept the mirrors you have"')
        s.append('echo; echo "Arch packages:"; sudo pacman -Syu')
    elif has("xbps-install"):
        s.append('echo; echo "Void packages:"; sudo xbps-install -Su')
    elif has("dnf"):
        s.append('echo; echo "Fedora packages:"; sudo dnf upgrade --refresh')
    elif has("apt"):
        s.append('echo; echo "Debian / Ubuntu packages:"; sudo apt update && sudo apt upgrade')
    elif has("zypper"):
        s.append('echo; echo "openSUSE packages:"; sudo zypper dup')
    elif has("emerge"):
        # Gentoo (V6.70): the sync the note asks for, then @world
        s.append('echo; echo "Gentoo packages:"; sudo emaint sync -a && sudo emerge -uDN @world')
    if has("flatpak"):
        s.append('echo; echo "Flatpak apps:"; flatpak update -y')
    if has("snap"):
        s.append('echo; echo "Snap apps:"; sudo snap refresh')
    if not s:
        if has("nixos-rebuild") or has("rpm-ostree"):
            # NixOS and the atomic Fedoras: a full system update is their own command, never this one
            print("Your system updates with sudo nixos-rebuild switch --upgrade (or rpm-ostree upgrade); nothing to do here")
            return
        sys.exit("rice-care: no package manager found")
    terminal("\n".join(s), "Updating the system")


# ---------------------------------------------------------------- cleaning
PKG_RE = re.compile(r"^(.+)-([^-]+)-([^-]+)-([^-]+)\.pkg\.tar(\.[a-z0-9]+)?$")


def cache_dirs():
    dirs = []
    if has("pacman-conf"):
        code, so, _ = run(["pacman-conf", "CacheDir"], 10)
        dirs = [d.strip().rstrip("/") for d in so.splitlines() if d.strip()]
    return [d for d in (dirs or ["/var/cache/pacman/pkg"]) if os.path.isdir(d)]


@functools.lru_cache(maxsize=None)
def vercmp(a, b):
    if a == b:
        return 0
    code, so, _ = run(["vercmp", a, b], 5)
    try:
        return int(so.strip())
    except ValueError:
        return (a > b) - (a < b)


def cache_plan():
    """the old package files: of every package the installed version and the newest other one stay (two in all, like
    paccache -rk2); of packages that are not installed any more nothing stays (paccache -ruk0). And the empty
    download-XXXX folders pacman leaves behind when a download stops. Returns (files, size, leftover folders)."""
    code, so, _ = run(["pacman", "-Q"], 30)
    if code != 0:
        return [], 0, []
    inst = {}
    for line in so.splitlines():
        p = line.split()
        if len(p) == 2:
            inst[p[0]] = p[1]
    groups, leftovers = {}, []
    for d in cache_dirs():
        try:
            names = os.listdir(d)
        except OSError:
            continue
        for f in names:
            full = os.path.join(d, f)
            if f.startswith("download-") and os.path.isdir(full) and not os.path.islink(full):
                leftovers.append(full)
                continue
            if f.endswith((".sig", ".part")) or os.path.islink(full) or not os.path.isfile(full):
                continue
            m = PKG_RE.match(f)
            if not m:
                continue
            groups.setdefault(m.group(1), []).append((m.group(2) + "-" + m.group(3), full))
    files, size = [], 0
    for name, vers in groups.items():
        keep = set()
        if name in inst:
            iv = inst[name].rsplit(":", 1)[-1]
            keep.add(iv)
            rest = sorted({v for v, _ in vers if v != iv}, key=functools.cmp_to_key(vercmp), reverse=True)
            keep.update(rest[:1])
        for v, full in vers:
            if v in keep:
                continue
            for x in (full, full + ".sig"):
                if os.path.isfile(x):
                    files.append(x)
                    try:
                        size += os.path.getsize(x)
                    except OSError:
                        pass
    return files, size, leftovers


def orphans():
    if not has("pacman"):
        return [], 0
    code, so, _ = run(["pacman", "-Qdtq"], 30)
    names = [n for n in so.split() if n]
    size = 0
    if names:
        code, so, _ = run(["pacman", "-Qi"] + names, 30)
        mult = {"B": 1, "KiB": 1024, "MiB": 1024 ** 2, "GiB": 1024 ** 3}
        for line in so.splitlines():
            if line.startswith("Installed Size"):
                try:
                    v, u = line.split(":", 1)[1].split()
                    size += int(float(v.replace(",", ".")) * mult.get(u, 1))
                except ValueError:
                    pass
    return names, size


def journal_size():
    if not has("journalctl"):
        return 0
    code, so, se = run(["journalctl", "--disk-usage"], 20)
    import re
    m = re.search(r"take up ([\d.]+)([KMGT])", so + se)
    if not m:
        return 0
    return int(float(m.group(1)) * {"K": 1024, "M": 1024 ** 2, "G": 1024 ** 3, "T": 1024 ** 4}[m.group(2)])


JOURNAL_KEEP = 200 * 1024 * 1024


def scan():
    items = []
    if has("pacman"):
        files, n, left = cache_plan()
        items.append({"id": "pkgcache", "name": "Old package files", "size": n, "root": True, "count": len(files),
                      "desc": "Downloaded packages; the last two versions of each stay" if files or not left
                      else "Folders left by downloads that stopped"})
        names, size = orphans()
        items.append({"id": "orphans", "name": "Packages nothing needs", "size": size, "root": True, "count": len(names),
                      "desc": ", ".join(names[:6]) + (" and %d more" % (len(names) - 6) if len(names) > 6 else "") if names else "None"})
        h = aur_helper()
        if h:
            d = HOME + "/.cache/" + h
            items.append({"id": "aurcache", "name": "AUR build files (%s)" % h, "size": du(d), "root": False, "desc": "What was left after building AUR packages"})
    j = journal_size()
    if j:
        items.append({"id": "journal", "name": "Old system logs", "size": max(0, j - JOURNAL_KEEP), "root": True, "desc": "The newest 200 MB stay"})
    if os.path.isdir("/var/lib/systemd/coredump"):
        items.append({"id": "coredumps", "name": "Crash reports", "size": du("/var/lib/systemd/coredump"), "root": True, "desc": "Saved when a program crashed"})
    items.append({"id": "thumbnails", "name": "Picture previews", "size": du(HOME + "/.cache/thumbnails"), "root": False, "desc": "Made again when needed"})
    items.append({"id": "trash", "name": "Trash", "size": du(HOME + "/.local/share/Trash"), "root": False, "desc": "Files you deleted"})
    print(json.dumps({"items": items, "total": sum(i["size"] for i in items)}))


def clean(ids):
    ids = [i for i in ids if i in ("pkgcache", "orphans", "journal", "coredumps", "aurcache", "thumbnails", "trash")]
    freed = 0
    user = {"aurcache": HOME + "/.cache/" + (aur_helper() or "yay"), "thumbnails": HOME + "/.cache/thumbnails", "trash": HOME + "/.local/share/Trash"}
    for i in ids:
        if i in user and os.path.isdir(user[i]):
            freed += du(user[i])
            for e in os.listdir(user[i]):
                p = os.path.join(user[i], e)
                try:
                    shutil.rmtree(p) if os.path.isdir(p) and not os.path.islink(p) else os.remove(p)
                except OSError:
                    pass
            if i == "trash":
                for sub in ("files", "info"):
                    os.makedirs(os.path.join(user[i], sub), exist_ok=True)
    s = []
    if "pkgcache" in ids:
        files, size, left = cache_plan()
        dirs = cache_dirs()
        ok = [f for f in files if os.path.dirname(os.path.realpath(f)) in [os.path.realpath(d) for d in dirs] and PKG_RE.match(os.path.basename(f).removesuffix(".sig"))]
        os.makedirs(CACHE, exist_ok=True)
        open(PKGLIST, "w").write("".join(f + "\n" for f in ok))
        line = 'echo "Old package files:"; '
        if ok:
            line += ('if sudo xargs -r -d "\\n" -a "%s" rm -f --; then echo "  removed %d files (%s)."; fi; ' % (PKGLIST, len(ok), human(size)))
        else:
            line += 'echo "  none: only the last two versions are there."; '
        line += 'rm -f "%s"' % PKGLIST
        if left:
            # pacman's own temporary download folders; never while pacman runs (it holds db.lck then)
            q = " ".join(shlex.quote(d) for d in dirs)
            line += ('; if [ -e /var/lib/pacman/db.lck ]; then echo "  pacman is busy: the leftover download folders stay for now."; '
                     'else sudo find %s -mindepth 1 -maxdepth 1 -type d -name "download-*" -exec rm -rf -- {} + && echo "  removed %d leftover download folders."; fi' % (q, len(left)))
        s.append(line)
    if "orphans" in ids:
        s.append('echo; echo "Packages nothing needs:"; o=$(pacman -Qdtq); if [ -n "$o" ]; then sudo pacman -Rns $o; else echo "  none"; fi')
    if "journal" in ids:
        s.append('echo; echo "Old system logs:"; sudo journalctl --vacuum-size=200M')
    if "coredumps" in ids:
        s.append('echo; echo "Crash reports:"; sudo find /var/lib/systemd/coredump -type f -delete && echo "  removed."')
    if s:
        terminal("\n".join(s), "Cleaning up")
    print(json.dumps({"freed": freed, "terminal": bool(s)}))


def human(b):
    return "%.1f GB" % (b / 1073741824) if b >= 1073741824 else "%d MB" % max(1, round(b / 1048576)) if b else "0 MB"


def wait():
    """until the terminal is done (its pid file is gone) or closed; at most 3 hours"""
    t0 = time.time()
    while not os.path.exists(PIDF):
        if time.time() - t0 > 20:
            print(json.dumps({"done": False}))
            return
        time.sleep(0.5)
    try:
        pid = int(open(PIDF).read().strip())
    except (OSError, ValueError):
        pid = 0
    while os.path.exists(PIDF) and time.time() - t0 < 3 * 3600:
        if pid:
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                break
            except PermissionError:
                pass
        time.sleep(1)
    print(json.dumps({"done": True}))


def main(a):
    cmd = a[1] if len(a) > 1 else ""
    if cmd == "updates":
        updates("--fresh" in a)
    elif cmd == "update":
        update()
    elif cmd == "scan":
        scan()
    elif cmd == "clean" and len(a) > 2:
        clean(a[2:])
    elif cmd == "wait":
        wait()
    else:
        print(__doc__.strip())
        sys.exit(1)


if __name__ == "__main__":
    main(sys.argv)
