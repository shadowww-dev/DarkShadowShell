#!/usr/bin/env bash
# Installs the fonts DarkShadow's Shell uses (Google Sans Flex and Google Sans Code, Inter, Rubik, Material Symbols
# Rounded and the six lock screen clock fonts) for the current user.
# Works on any distro (NixOS too): files go to ~/.local/share/fonts, no root needed.
#   rice-fonts           install what is missing
#   rice-fonts status    show what is installed
set -euo pipefail
dir="$HOME/.local/share/fonts/shadows-shell"
# every download is a commit or a tag, and its SHA-256 is in install/checksums.txt (nothing moves with upstream)
FONTS_REV="06bfe0d62a98375cb09c942fa18e68bd32cff057"
MDI_REV="10ecc14790612ca8fd164e3f4ffe9c16fc50d5b7"
CJK_REV="f8d157532fbfaeda587e826d4cd5b21a49186f7c"
NF_REV="v3.5.1"
INTER_URL="https://github.com/rsms/inter/releases/download/v4.1/Inter-4.1.zip"
RUBIK_URL="https://raw.githubusercontent.com/google/fonts/$FONTS_REV/ofl/rubik/Rubik%5Bwght%5D.ttf"
# icons of the dashboard (the same set Caelestia and end4 use)
SYMBOLS_URL="https://raw.githubusercontent.com/google/material-design-icons/$MDI_REV/variablefont/MaterialSymbolsRounded%5BFILL%2CGRAD%2Copsz%2Cwght%5D.ttf"

has() {
  local fams
  fams="$(fc-list : family 2>/dev/null || true)"
  grep -qiE "(^|,)$1( |,|$)" <<<"$fams"
}

# the hashes install.sh put next to the scripts (a repo checkout works too)
SUMS="$HOME/.local/share/rice/checksums.txt"
[ -f "$SUMS" ] || SUMS="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)/install/checksums.txt"
sha256_of() {
  if command -v sha256sum >/dev/null; then sha256sum "$1" | cut -c1-64
  else shasum -a 256 "$1" | cut -c1-64; fi
}
get() { # get NAME URL DEST: download once, keep it only when it matches its pinned SHA-256
  local name="$1" url="$2" dst="$3" want got
  want="$(awk -v n="$name" '$2 == n { print $1; exit }' "$SUMS" 2>/dev/null)"
  if [ -z "$want" ]; then echo "$name: no SHA-256 in install/checksums.txt, not downloading"; return 1; fi
  curl -fsSL -o "$dst" "$url" || return 1
  got="$(sha256_of "$dst")"
  if [ "$got" != "$want" ]; then
    rm -f "$dst"
    echo "$name: does not match its SHA-256 (got ${got:-nothing}), not used"
    return 1
  fi
}

# lock screen clock fonts (Settings > Idle & Lockscreen > Clock font), all SIL Open Font License
GF="https://raw.githubusercontent.com/google/fonts/$FONTS_REV/ofl"
CLOCK_FONTS=(
  "Bebas Neue|$GF/bebasneue/BebasNeue-Regular.ttf|BebasNeue.ttf"
  "Orbitron|$GF/orbitron/Orbitron%5Bwght%5D.ttf|Orbitron-Variable.ttf"
  "Outfit|$GF/outfit/Outfit%5Bwght%5D.ttf|Outfit-Variable.ttf"
  "Space Grotesk|$GF/spacegrotesk/SpaceGrotesk%5Bwght%5D.ttf|SpaceGrotesk-Variable.ttf"
  "Unbounded|$GF/unbounded/Unbounded%5Bwght%5D.ttf|Unbounded-Variable.ttf"
  "Big Shoulders Display|$GF/bigshouldersdisplay/BigShouldersDisplay%5Bwght%5D.ttf|BigShouldersDisplay-Variable.ttf"
)

# Japanese, Korean and Chinese text (Settings > System > Languages): Noto Sans CJK for that language, three weights
# (about 13 MB). rice-fonts cjk ja|ko|zh-CN  (exit 0: there now, 2: it was there already, 1: could not download)
CJK_URL="https://raw.githubusercontent.com/notofonts/noto-cjk/$CJK_REV/Sans/SubsetOTF"
if [ "${1:-}" = "cjk" ]; then
  case "${2:-}" in
    ja*) sub=JP; lc=ja ;; ko*) sub=KR; lc=ko ;; zh-TW|zh-HK) sub=TC; lc=zh-tw ;; zh*) sub=SC; lc=zh-cn ;;
    *) echo "rice-fonts cjk ja|ko|zh-CN" >&2; exit 1 ;;
  esac
  if fc-list ":lang=$lc" family 2>/dev/null | grep -q .; then echo "Fonts for $lc: already installed"; exit 2; fi
  command -v curl >/dev/null || { echo "rice-fonts: curl is needed" >&2; exit 1; }
  mkdir -p "$dir/cjk"
  ok=0
  for w in Regular Medium Bold; do
    f="NotoSans$sub-$w.otf"
    if get "$f" "$CJK_URL/$sub/$f" "$dir/cjk/$f.part" && [ "$(head -c 4 "$dir/cjk/$f.part")" = "OTTO" ]; then
      mv "$dir/cjk/$f.part" "$dir/cjk/$f"; ok=1
    else
      rm -f "$dir/cjk/$f.part"
    fi
  done
  [ "$ok" = 1 ] || { echo "Fonts for $lc: could not download"; exit 1; }
  fc-cache -f "$dir" >/dev/null 2>&1 || true
  echo "Fonts for $lc: installed (Noto Sans $sub)"
  exit 0
fi

if [ "${1:-}" = "status" ]; then
  for f in "Google Sans Flex" "Google Sans Code" Inter Rubik "Material Symbols Rounded" "Bebas Neue" Orbitron Outfit "Space Grotesk" Unbounded "Big Shoulders Display"; do if has "$f"; then echo "$f: installed"; else echo "$f: missing"; fi; done
  exit 0
fi

command -v curl >/dev/null || { echo "rice-fonts: curl is needed" >&2; exit 1; }
mkdir -p "$dir"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
changed=0

# Google Sans Flex (the interface font since V3.23) and Google Sans Code: open source, SIL Open Font License
for e in "Google Sans Flex|$GF/googlesansflex/GoogleSansFlex%5BROND%2Copsz%2Cslnt%2Cwdth%2Cwght%5D.ttf|GoogleSansFlex-Variable.ttf" \
         "Google Sans Code|$GF/googlesanscode/GoogleSansCode%5Bwght%5D.ttf|GoogleSansCode-Variable.ttf"; do
  IFS='|' read -r fam url file <<<"$e"
  if has "$fam"; then
    echo "$fam: already installed"
  elif get "$file" "$url" "$tmp/$file" && [ "$(head -c 4 "$tmp/$file" | od -An -tx1 | tr -d ' ')" = "00010000" ]; then
    mv "$tmp/$file" "$dir/$file"
    echo "$fam: installed"
    changed=1
  else
    echo "$fam: could not download"
  fi
done

if has Inter; then
  echo "Inter: already installed"
else
  echo "Inter: downloading..."
  if get Inter-4.1.zip "$INTER_URL" "$tmp/inter.zip"; then
    python3 - "$tmp/inter.zip" "$dir" <<'PY'
import sys, zipfile
z = zipfile.ZipFile(sys.argv[1])
for n in ("InterVariable.ttf", "InterVariable-Italic.ttf"):
    open(sys.argv[2] + "/" + n, "wb").write(z.read(n))
PY
    changed=1
  else
    echo "Inter: could not download"
  fi
fi

if has Rubik; then
  echo "Rubik: already installed"
else
  echo "Rubik: downloading..."
  if get Rubik-Variable.ttf "$RUBIK_URL" "$tmp/Rubik-Variable.ttf"; then
    mv "$tmp/Rubik-Variable.ttf" "$dir/Rubik-Variable.ttf"
    changed=1
  else
    echo "Rubik: could not download"
  fi
fi

if has "Material Symbols Rounded"; then
  echo "Material Symbols Rounded: already installed"
else
  echo "Material Symbols Rounded: downloading..."
  if get MaterialSymbolsRounded.ttf "$SYMBOLS_URL" "$tmp/symbols.ttf" && [ "$(head -c 4 "$tmp/symbols.ttf" | od -An -tx1 | tr -d ' ')" = "00010000" ]; then
    mv "$tmp/symbols.ttf" "$dir/MaterialSymbolsRounded.ttf"
    changed=1
  else
    echo "Material Symbols Rounded: could not download (the dashboard uses Nerd Font icons instead)"
  fi
fi

# icons: JetBrains Mono Nerd Font and Symbols Nerd Font (packaged on Arch and NixOS, not on Fedora)
NF="https://github.com/ryanoasis/nerd-fonts/releases/download/$NF_REV"
for e in "JetBrainsMono Nerd Font|JetBrainsMono|JetBrainsMonoNerdFont-*.ttf" "Symbols Nerd Font|NerdFontsSymbolsOnly|SymbolsNerdFont-*.ttf"; do
  IFS='|' read -r fam pkg pat <<<"$e"
  if has "$fam"; then
    echo "$fam: already installed"
  elif command -v tar >/dev/null && get "$pkg.tar.xz" "$NF/$pkg.tar.xz" "$tmp/$pkg.tar.xz" &&
       mkdir -p "$dir/$pkg" && tar -xJf "$tmp/$pkg.tar.xz" -C "$dir/$pkg" --wildcards "$pat" 2>/dev/null; then
    echo "$fam: installed"
    changed=1
  else
    echo "$fam: could not download (icons may show as boxes)"
  fi
done

# the CachyOS logo (U+F385) needs Nerd Fonts 3.4 or newer: with an older icon font it shows as a box
# (only Nerd Fonts count: Material Symbols and Unifont use the same code range for other pictures)
if command -v fc-list >/dev/null && ! fc-list ':charset=f385' family 2>/dev/null | grep -qi 'nerd'; then
  echo "Logo icons (CachyOS): your Nerd Font is older, downloading the newest icons..."
  if command -v tar >/dev/null && get NerdFontsSymbolsOnly.tar.xz "$NF/NerdFontsSymbolsOnly.tar.xz" "$tmp/logos.tar.xz" &&
     mkdir -p "$dir/NerdFontsSymbolsOnly" && tar -xJf "$tmp/logos.tar.xz" -C "$dir/NerdFontsSymbolsOnly" --wildcards "SymbolsNerdFont-*.ttf" 2>/dev/null; then
    echo "Logo icons: installed"
    changed=1
  else
    echo "Logo icons: could not download (the CachyOS logo may show as a box)"
  fi
fi

for e in "${CLOCK_FONTS[@]}"; do
  IFS='|' read -r fam url file <<<"$e"
  if has "$fam"; then
    echo "$fam: already installed"
  elif get "$file" "$url" "$tmp/clock.ttf" && [ "$(head -c 4 "$tmp/clock.ttf" | od -An -tx1 | tr -d ' ')" = "00010000" ]; then
    mv "$tmp/clock.ttf" "$dir/$file"
    echo "$fam: installed (lock screen clock)"
    changed=1
  else
    echo "$fam: could not download (the lock screen clock uses your Numbers font instead)"
  fi
done

if [ "$changed" = 1 ]; then
  fc-cache -f "$dir" >/dev/null 2>&1 || true
  echo "Done. Fonts are in $dir"
fi
