#!/usr/bin/env python3
"""rice-busy: prints 1 while the screen has tiled windows on it, 0 when the desktop is empty.
Floating windows (Settings, pop-ups, a floating-only layout) do not count: the widgets stay, and neither does
a window that is not on that screen (Infinite Desktop's canvas can hold one far away).

  rice-busy [MONITOR]     MONITOR: name like DP-1 (default: the focused one)

Listens to Hyprland's events (or niri's event stream) and prints a line only when the answer changes. The desktop
widgets use it for "Auto-hide widgets" (Settings > Desktop): they hide while windows are open.
"""
import json
import os
import socket
import subprocess
import sys
import time

EVENTS = (b"openwindow>>", b"closewindow>>", b"movewindow", b"workspace", b"focusedmon>>", b"activespecial",
          b"changefloatingmode>>", b"moveworkspace", b"destroyworkspace", b"createworkspace", b"fullscreen>>")


def hypr(what):
    """V4.96: asked over Hyprland's own socket (it started hyprctl twice for every change and every 4 seconds)"""
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(3)
        s.connect(sock_path().replace(".socket2.sock", ".socket.sock"))
        s.sendall(b"j/" + what.encode())
        out = b""
        while True:
            d = s.recv(65536)
            if not d:
                break
            out += d
        s.close()
        return json.loads(out.decode(errors="replace"))
    except Exception:
        pass
    try:
        r = subprocess.run(["hyprctl", "-j", what], capture_output=True, text=True, timeout=3)
        return json.loads(r.stdout)
    except Exception:
        return None


def mon_rect(m):
    """the monitor's place on the layout, in the same units as a window's at/size (logical, scale taken out)"""
    sc = float(m.get("scale") or 1) or 1
    w, h = float(m.get("width") or 0) / sc, float(m.get("height") or 0) / sc
    if int(m.get("transform") or 0) % 2:     # turned by 90°: the sides swap
        w, h = h, w
    return float(m.get("x") or 0), float(m.get("y") or 0), w, h


def on_screen(c, r):
    """a window counts only when it is on that screen: on the Infinite Desktop's canvas it can sit far away"""
    try:
        x, y = (float(v) for v in (c.get("at") or (0, 0))[:2])
        w, h = (float(v) for v in (c.get("size") or (0, 0))[:2])
    except (TypeError, ValueError):
        return True
    return x < r[0] + r[2] and x + w > r[0] and y < r[1] + r[3] and y + h > r[1]


def busy(mon_name):
    mons = hypr("monitors")
    clients = hypr("clients")
    if not mons or clients is None:
        # V7.00: a read that failed is not an empty desktop. Saying "0" here showed every widget over the windows
        # until the next event; the caller keeps its last answer instead
        return None
    mon = None
    for m in mons:
        if (mon_name and m.get("name") == mon_name) or (not mon_name and m.get("focused")):
            mon = m
    if mon is None:
        mon = mons[0]
    ids = {mon.get("activeWorkspace", {}).get("id")}
    sp = mon.get("specialWorkspace", {}) or {}
    if sp.get("id"):
        ids.add(sp.get("id"))
    rect = mon_rect(mon)
    # only tiled (or fullscreen) windows hide the widgets; floating ones leave them alone, and so does one that
    # is not on the screen at all (Infinite Desktop can put a window anywhere on its canvas)
    for c in clients:
        if (c.get("workspace", {}) or {}).get("id") not in ids:
            continue
        if not c.get("mapped", True) or c.get("hidden", False):
            continue
        if not on_screen(c, rect):
            continue
        if c.get("floating", False) and not c.get("fullscreen", 0):
            continue
        return True
    return False


_niri_sock = [None]


def niri_j(what):
    """V7.01: asked over niri's socket, kept open. The event stream used to start two niri processes for every
    window event (a drag or a focus change queued them), plus a 50 ms sleep that made the answer lag."""
    for attempt in (0, 1):
        try:
            if _niri_sock[0] is None:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.settimeout(3)
                s.connect(os.environ["NIRI_SOCKET"])
                _niri_sock[0] = (s, s.makefile("rb"))
            s, f = _niri_sock[0]
            s.sendall((json.dumps({"Request": what.capitalize()}) + "\n").encode())
            line = f.readline()
            if not line:
                raise OSError("closed")
            r = json.loads(line)
            if isinstance(r, dict) and isinstance(r.get("Ok"), dict):
                return r["Ok"].get(what.capitalize())
            raise OSError("no Ok")
        except Exception:
            try:
                _niri_sock[0][0].close()
            except Exception:
                pass
            _niri_sock[0] = None
    return None


def niri_busy(mon_name):
    """niri: tiled windows on the active workspace of that monitor (the focused one by default)"""
    wss = niri_j("workspaces")
    wins = niri_j("windows")
    if not wss or wins is None:
        return None
    if not mon_name:
        f = next((w for w in wss if w.get("is_focused")), None)
        mon_name = f.get("output") if f else ""
    act = next((w for w in wss if w.get("is_active") and (w.get("output") == mon_name or not mon_name)), None)
    if not act:
        return False
    return any(w.get("workspace_id") == act["id"] and not w.get("is_floating") for w in wins)


def niri_main(mon):
    last = [None]

    def say():
        b = niri_busy(mon)
        if b is None:
            return
        if b != last[0]:
            last[0] = b
            print("1" if b else "0", flush=True)

    say()
    while True:
        try:
            p = subprocess.Popen(["niri", "msg", "-j", "event-stream"], stdout=subprocess.PIPE, text=True)
            for line in p.stdout:
                if line.startswith(('{"Workspace', '{"Window')) and not line.startswith(('{"WindowFocusTimestamp', '{"WindowLayouts')):
                    say()
            p.wait()
        except Exception:
            pass
        time.sleep(2)
        say()


def sock_path():
    run = os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    if not sig:
        try:
            sig = sorted(os.listdir(run + "/hypr"), key=lambda d: os.path.getmtime(run + "/hypr/" + d))[-1]
        except Exception:
            sig = ""
    return "%s/hypr/%s/.socket2.sock" % (run, sig)


def main():
    mon = sys.argv[1] if len(sys.argv) > 1 else ""
    if os.environ.get("NIRI_SOCKET"):
        return niri_main(mon)
    last = None

    def say():
        nonlocal last
        b = busy(mon)
        if b is None:
            return
        if b != last:
            last = b
            print("1" if b else "0", flush=True)

    say()
    while True:
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.connect(sock_path())
            buf = b""
            s.settimeout(30)
            while True:
                try:
                    data = s.recv(4096)
                except socket.timeout:
                    say()          # a check now and then, in case an event was missed
                    continue
                if not data:
                    break
                buf += data
                lines = buf.split(b"\n")
                buf = lines.pop()
                if any(l.startswith(EVENTS) for l in lines):
                    # let Hyprland finish the change, and take the events that come with it in one go (switching a
                    # workspace sends several): one check for all of them
                    s.settimeout(0.08)
                    try:
                        while s.recv(4096):
                            pass
                    except (socket.timeout, BlockingIOError):
                        pass
                    s.settimeout(30)
                    buf = b""
                    say()
        except (OSError, ValueError):
            pass
        time.sleep(2)
        say()


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, BrokenPipeError):
        pass
