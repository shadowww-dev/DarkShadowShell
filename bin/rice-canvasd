#!/usr/bin/env python3
import json
import os
import re
import select
import signal
import struct
import subprocess
import sys
import time

RUN = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
PID = os.path.join(RUN, "rice-canvasd.pid")
STATUS = os.path.join(RUN, "rice-canvasd.json")
CONF = os.path.expanduser("~/.config/rice/infinite.conf")

EV = struct.Struct("llHHi")
EV_SYN, EV_KEY, EV_REL, EV_ABS = 0, 1, 2, 3
REL_X, REL_Y = 0, 1
ABS_X, ABS_Y = 0, 1
ABS_MT_SLOT = 47
ABS_MT_POSITION_X = 53
ABS_MT_POSITION_Y = 54
ABS_MT_TRACKING_ID = 57
INF_STATE = os.path.expanduser("~/.config/rice/infinite.state")
_inf_st = [0, False]


def is_infinite_on():
    if NIRI:
        return bool(nstate().get("on"))
    try:
        mt = os.path.getmtime(INF_STATE)
        if mt != _inf_st[0]:
            _inf_st[0] = mt
            _inf_st[1] = False
            for line in open(INF_STATE):
                if line.startswith("on="):
                    _inf_st[1] = (line.strip() == "on=1")
                    break
    except OSError:
        _inf_st[1] = False
    return _inf_st[1]
META = (125, 126)
ALT = (56, 100)
CTRL = (29, 97)
BTN_LEFT = 272
BTN_TOOL_FINGER = 325
BTN_TOUCH = 330

NIRI = bool(os.environ.get("NIRI_SOCKET"))
KEY_DEFAULTS = {"key_toggle": "SUPER + ALT + F" if NIRI else "SUPER + F", "mod_hold": "SUPER + ALT",
                "mod_go": "SUPER + ALT + SHIFT" if NIRI else "SUPER + CTRL", "mod_zoom": "CTRL"}
MODKEYS = {"SUPER": META, "ALT": ALT, "CTRL": CTRL, "SHIFT": (42, 54)}


def conf():
    c = {"speed": 1.0, "dir": 1, "push": 1}
    c.update(KEY_DEFAULTS)
    try:
        for line in open(CONF):
            m = re.match(r"^\s*(\w+)\s*=\s*(.*?)\s*$", line)
            if not m or m.group(1) not in c:
                continue
            k, v = m.group(1), m.group(2)
            if k in KEY_DEFAULTS:
                if v:
                    c[k] = v
            else:
                try:
                    c[k] = float(v)
                except ValueError:
                    pass
    except OSError:
        pass
    return c


def mods_of(combo):
    return {p.strip().upper() for p in combo.split("+") if p.strip().upper() in MODKEYS}


def bits(words):
    out = set()
    for i, w in enumerate(reversed(words.split())):
        v = int(w, 16)
        b = 0
        while v:
            if v & 1:
                out.add(i * 64 + b)
            v >>= 1
            b += 1
    return out


def devices():
    kbd, mice, pads = [], [], []
    try:
        blocks = open(os.environ.get("RICE_INPUT_DEVICES", "/proc/bus/input/devices")).read().split("\n\n")
    except OSError:
        return kbd, mice, pads
    for b in blocks:
        h = re.search(r"^H: Handlers=(.*)$", b, re.M)
        if not h:
            continue
        ev = re.search(r"\bevent\d+\b", h.group(1))
        if not ev:
            continue
        path = os.environ.get("RICE_INPUT_DIR", "/dev/input") + "/" + ev.group(0)
        n = re.search(r'^N: Name="(.*)"$', b, re.M)
        name = n.group(1).lower() if n else ""
        k = re.search(r"^B: KEY=(.*)$", b, re.M)
        r = re.search(r"^B: REL=(.*)$", b, re.M)
        a = re.search(r"^B: ABS=(.*)$", b, re.M)
        keys = bits(k.group(1)) if k else set()
        rels = bits(r.group(1)) if r else set()
        abss = bits(a.group(1)) if a else set()
        is_pad = ((BTN_TOUCH in keys or BTN_TOOL_FINGER in keys) and (ABS_X in abss or 53 in abss)) or any(w in name for w in ("touchpad", "trackpad"))
        if is_pad:
            pads.append(path)
        elif REL_X in rels and REL_Y in rels and BTN_LEFT in keys:
            mice.append(path)
        elif 30 in keys and 44 in keys and (125 in keys or 126 in keys):
            kbd.append(path)
    return kbd, mice, pads


def status(**kw):
    try:
        tmp = STATUS + ".tmp"
        json.dump(dict(kw, pid=os.getpid(), t=int(time.time())), open(tmp, "w"))
        os.replace(tmp, STATUS)
    except OSError:
        pass


def hypr_alive():
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    return bool(sig) and os.path.isdir(os.path.join(RUN, "hypr", sig))


def check():
    kbd, mice, pads = devices()
    print("keyboards:", ", ".join(kbd) or "none found")
    print("mice:     ", ", ".join(mice) or "none found")
    print("touchpads:", ", ".join(pads) or "none found")
    bad = [p for p in kbd + mice + pads if not os.access(p, os.R_OK)]
    if bad:
        print("cannot read:", ", ".join(bad))
        print("-> your user needs the 'input' group (Settings > Desktop > Infinite Desktop > Allow), then log in again")
    elif kbd and (mice or pads):
        print("ok: it can read them")
    print("Hyprland:  ", "yes" if hypr_alive() else "no")
    print("niri:      ", "yes" if NIRI else "no")


def tell():
    try:
        groups = subprocess.run(["id", "-nG"], capture_output=True, text=True, timeout=2).stdout.split()
    except Exception:
        groups = []
    if "input" in groups:
        body = "You joined the input group: log out and back in once, then it works."
    elif os.path.exists("/etc/NIXOS"):
        body = 'Add programs.shadows-shell.user = "%s"; to configuration.nix (or "input" to your extraGroups), rebuild, then log in again.' % os.environ.get("USER", "you")
    else:
        body = "One step: Settings > Desktop > Infinite Desktop > Allow (then log in again)."
    try:
        subprocess.Popen(["notify-send", "-a", "Infinite Desktop", "-i", "input-mouse", "SUPER + ALT + mouse / touchpad needs one step", body],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def hypr_eval(code):
    return subprocess.Popen(["hyprctl", "eval", code], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cursor():
    try:
        a, b = subprocess.run(["hyprctl", "cursorpos"], capture_output=True, text=True, timeout=0.5).stdout.split(",")
        return float(a), float(b)
    except Exception:
        return None


NSTATE = os.path.expanduser("~/.config/rice/infinite-niri.json")
_sock = [None]


def nreq(req):
    import socket
    for attempt in (0, 1):
        try:
            if _sock[0] is None:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.settimeout(2)
                s.connect(os.environ["NIRI_SOCKET"])
                _sock[0] = (s, s.makefile("rb"))
            s, f = _sock[0]
            s.sendall((json.dumps(req) + "\n").encode())
            line = f.readline()
            if not line:
                raise OSError("closed")
            r = json.loads(line)
            return r.get("Ok") if isinstance(r, dict) else None
        except Exception:
            try:
                _sock[0][0].close()
            except Exception:
                pass
            _sock[0] = None
    return None


def nact(name, **kw):
    return nreq({"Action": {name: kw}})


def nstate():
    try:
        return json.load(open(NSTATE))
    except Exception:
        return {"on": False, "ws": None, "floated": []}


def nsave(st):
    try:
        os.makedirs(os.path.dirname(NSTATE), exist_ok=True)
        json.dump(st, open(NSTATE, "w"))
    except OSError:
        pass


def nwindows():
    r = nreq("Windows")
    return (r or {}).get("Windows") or []


def nactive_ws():
    for w in (nreq("Workspaces") or {}).get("Workspaces") or []:
        if w.get("is_focused"):
            return w.get("id")
    return None


_cache = {"t": 0, "ids": []}


def niri_slide(dx, dy):
    if not dx and not dy:
        return
    now = time.time()
    if now - _cache["t"] > 0.5:
        ws = nactive_ws()
        _cache["ids"] = [w["id"] for w in nwindows() if w.get("workspace_id") == ws and w.get("is_floating")]
        _cache["t"] = now
    for i in _cache["ids"]:
        nact("MoveFloatingWindow", id=i, x={"AdjustFixed": float(dx)}, y={"AdjustFixed": float(dy)})


def niri_tick():
    st = nstate()
    if not st.get("on"):
        return
    changed = False
    for w in nwindows():
        if w.get("workspace_id") == st.get("ws") and not w.get("is_floating"):
            nact("MoveWindowToFloating", id=w["id"])
            st.setdefault("floated", []).append(w["id"])
            changed = True
    if changed:
        nsave(st)


def notify(text):
    try:
        subprocess.Popen(["notify-send", "-t", "1600", "-a", "Infinite Desktop", "Infinite Desktop", text],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def niri_cmd(a):
    if not NIRI:
        print("not in niri", file=sys.stderr)
        sys.exit(1)
    cmd = a[0] if a else "state"
    st = nstate()
    if cmd == "toggle":
        cmd = "off" if st.get("on") else "on"
    if cmd == "on":
        ws = nactive_ws()
        floated = []
        for w in nwindows():
            if w.get("workspace_id") == ws and not w.get("is_floating"):
                nact("MoveWindowToFloating", id=w["id"])
                floated.append(w["id"])
        nsave({"on": True, "ws": ws, "floated": floated})
        c = conf()
        notify("On: hold %s and move the mouse or touchpad" % c["mod_hold"])
        try:
            kbd, mice, pads = devices()
            if any(not os.access(p, os.R_OK) for p in kbd + mice + pads):
                tell()
        except Exception:
            pass
    elif cmd == "off":
        alive = {w["id"] for w in nwindows()}
        for i in st.get("floated", []):
            if i in alive:
                nact("MoveWindowToTiling", id=i)
        nsave({"on": False, "ws": None, "floated": []})
        notify("Off: windows are tiled again")
    elif cmd == "pan" and len(a) >= 3:
        _cache["t"] = 0
        niri_slide(int(float(a[1])), int(float(a[2])))
    elif cmd == "go" and len(a) >= 2:
        niri_go(a[1])
    elif cmd == "state":
        print(json.dumps(dict(st, niri=True)))


def niri_go(d):
    ws = nactive_ws()
    out = (nreq("FocusedOutput") or {}).get("FocusedOutput") or {}
    lg = out.get("logical") or {}
    sw, sh = lg.get("width", 1920), lg.get("height", 1080)
    ws_wins = [w for w in nwindows() if w.get("workspace_id") == ws and w.get("is_floating")]

    def center(w):
        L = w.get("layout") or {}
        p = L.get("tile_pos_in_workspace_view")
        sz = L.get("tile_size") or [0, 0]
        return None if not p else (p[0] + sz[0] / 2, p[1] + sz[1] / 2)
    cur = next((w for w in ws_wins if w.get("is_focused")), None)
    here = center(cur) if cur else (sw / 2, sh / 2)
    if not here:
        return
    vec = {"left": (-1, 0), "right": (1, 0), "up": (0, -1), "down": (0, 1)}.get(d)
    if not vec:
        return
    best, bd = None, 1e18
    for w in ws_wins:
        if cur and w["id"] == cur["id"]:
            continue
        c = center(w)
        if not c:
            continue
        dx, dy = c[0] - here[0], c[1] - here[1]
        along = dx * vec[0] + dy * vec[1]
        if along <= 10:
            continue
        side = abs(dx * vec[1]) + abs(dy * vec[0])
        score = along + side * 2
        if score < bd:
            best, bd = (w, c), score
    if not best:
        return
    w, c = best
    tx, ty = sw / 2 - c[0], sh / 2 - c[1]
    ids = [x["id"] for x in ws_wins]
    done = [0.0, 0.0]
    for i in range(1, 11):
        k = 1 - (1 - i / 10) ** 3
        sx, sy = round(tx * k - done[0]), round(ty * k - done[1])
        for wid in ids:
            nact("MoveFloatingWindow", id=wid, x={"AdjustFixed": float(sx)}, y={"AdjustFixed": float(sy)})
        done[0] += sx
        done[1] += sy
        time.sleep(0.016)
    nact("FocusWindow", id=w["id"])


def main():
    if "--check" in sys.argv:
        check()
        return
    if "--tell" in sys.argv:
        kbd, mice, pads = devices()
        if any(not os.access(p, os.R_OK) for p in kbd + mice + pads):
            tell()
        return
    if "--niri" in sys.argv:
        niri_cmd(sys.argv[sys.argv.index("--niri") + 1:])
        return
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and not NIRI:
        return
    try:
        old = int(open(PID).read().strip())
        if old != os.getpid() and os.path.exists("/proc/%d" % old) and "rice-canvasd" in open("/proc/%d/cmdline" % old).read():
            return
    except (OSError, ValueError):
        pass
    open(PID, "w").write(str(os.getpid()))
    signal.signal(signal.SIGTERM, lambda *a: sys.exit(0))

    fds = {}
    pad_pos = {}
    pad_mt = {}
    held = set()
    acc = [0.0, 0.0]
    zoom_acc = 1.0
    zoom_changed = False
    zoom_ended = False
    moved_rel = False
    rel_hold = False
    hold_t = 0
    proc = None
    last_scan = 0
    last_tick = 0
    last_send = 0
    last_zoom = 0
    was_on = None
    last_cur = None
    c = conf()
    denied = []
    kbd, mice, pads = [], [], []

    while True:
        now = time.time()
        if now - last_scan > 3:
            last_scan = now
            if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and not hypr_alive():
                return
            if NIRI and not os.path.exists(os.environ.get("NIRI_SOCKET", "")):
                return
            c = conf()
            kbd, mice, pads = devices()
            want = {p: "k" for p in kbd}
            want.update({p: "m" for p in mice})
            want.update({p: "p" for p in pads})
            have = {v[0] for v in fds.values()}
            for p, kind in want.items():
                if p in have:
                    continue
                try:
                    fd = os.open(p, os.O_RDONLY | os.O_NONBLOCK)
                    fds[fd] = (p, kind)
                    if p in denied:
                        denied.remove(p)
                except PermissionError:
                    if p not in denied:
                        denied.append(p)
                except OSError:
                    pass
            kinds = [v[1] for v in fds.values()]
            status(keyboards=kinds.count("k"), mice=kinds.count("m") + kinds.count("p"), pads=kinds.count("p"),
                   found_keyboards=len(kbd), found_mice=len(mice) + len(pads), found_pads=len(pads),
                   denied=len(denied))
        if NIRI and now - last_tick > 0.6:
            last_tick = now
            niri_tick()
        r = []
        if fds:
            try:
                r, _, _ = select.select(list(fds), [], [], 0.016)
            except (OSError, ValueError):
                r = []
        else:
            time.sleep(0.5)
        for fd in r:
            kind = fds.get(fd, ("", ""))[1]
            try:
                data = os.read(fd, EV.size * 64)
            except BlockingIOError:
                continue
            except OSError:
                os.close(fd)
                fds.pop(fd, None)
                pad_pos.pop(fd, None)
                pad_mt.pop(fd, None)
                continue
            if not data:
                os.close(fd)
                fds.pop(fd, None)
                pad_pos.pop(fd, None)
                pad_mt.pop(fd, None)
                continue
            for i in range(0, len(data) - EV.size + 1, EV.size):
                _, _, t, code, val = EV.unpack_from(data, i)
                if t == EV_KEY:
                    if val == 1:
                        held.add(code)
                    elif val == 0:
                        held.discard(code)
                        if code in (BTN_TOOL_FINGER, BTN_TOUCH) and fd in pad_pos:
                            pad_pos[fd] = [None, None]
                elif t == EV_REL and code in (REL_X, REL_Y):
                    acc[code] += val
                    moved_rel = True
                    rel_hold = True
                elif t == EV_ABS and kind == "p":
                    mt = pad_mt.setdefault(fd, {"slot": 0, "slots": {}, "dist": None})
                    if code == ABS_MT_SLOT:
                        mt["slot"] = val
                    elif code == ABS_MT_TRACKING_ID:
                        slot = mt["slots"].setdefault(mt["slot"], {})
                        slot["id"] = val
                        if val == -1:
                            slot.pop("x", None)
                            slot.pop("y", None)
                    elif code == ABS_MT_POSITION_X:
                        mt["slots"].setdefault(mt["slot"], {})["x"] = val
                    elif code == ABS_MT_POSITION_Y:
                        mt["slots"].setdefault(mt["slot"], {})["y"] = val
                    elif code in (ABS_X, ABS_Y):
                        cur = pad_pos.get(fd)
                        if cur is None:
                            cur = [None, None]
                            pad_pos[fd] = cur
                        if cur[code] is not None and mode:
                            delta = val - cur[code]
                            if abs(delta) < 800:
                                acc[code] += delta * 0.4
                                moved_rel = True
                                rel_hold = True
                        cur[code] = val
            if kind == "p" and fd in pad_mt:
                mt = pad_mt[fd]
                active = [s for s in mt["slots"].values() if s.get("id", -1) >= 0 and s.get("x") is not None and s.get("y") is not None]
                if len(active) == 2:
                    d = ((active[0]["x"] - active[1]["x"]) ** 2 + (active[0]["y"] - active[1]["y"]) ** 2) ** 0.5
                    if mt["dist"] is not None and mt["dist"] > 20:
                        ratio = d / mt["dist"]
                        if 0.5 < ratio < 2.0 and abs(d - mt["dist"]) > 2:
                            zoom_acc *= ratio
                            zoom_changed = True
                    mt["dist"] = d
                else:
                    if mt["dist"] is not None:
                        mt["dist"] = None
                        zoom_ended = True

        down = {name for name, codes in MODKEYS.items() if any(k in held for k in codes)}
        need = mods_of(c.get("mod_hold", "SUPER + ALT")) or {"SUPER", "ALT"}
        mode = None
        if need <= down and not ((down - need) & {"SUPER", "ALT", "CTRL"}):
            mode = "canvas"
        elif "SUPER" in down and BTN_LEFT in held and not (down & {"ALT", "CTRL"}) and int(c.get("push", 0)) == 1 and not NIRI:
            mode = "push"

        inf_on = is_infinite_on()
        if zoom_changed and not NIRI and (inf_on or "CTRL" in down or mode == "canvas"):
            if abs(zoom_acc - 1.0) >= 0.003 and time.time() - last_zoom > 0.016:
                zf = max(0.7, min(1.4, zoom_acc))
                hypr_eval("if RiceInfinite then RiceInfinite.zoom_factor(%.5f, true) end" % zf)
                zoom_acc = 1.0
                zoom_changed = False
                last_zoom = time.time()
        if zoom_ended and not NIRI:
            if inf_on or mode == "canvas":
                hypr_eval("if RiceInfinite then RiceInfinite.save() end")
            zoom_ended = False
            zoom_acc = 1.0

        if mode != was_on:
            if was_on == "canvas" and not NIRI:
                hypr_eval("if RiceInfinite then RiceInfinite.save() end")
            acc = [0.0, 0.0]
            moved_rel = False
            rel_hold = False
            hold_t = time.time()
            last_cur = cursor() if mode == "canvas" and not NIRI else None
            for pfd in pad_pos:
                pad_pos[pfd] = [None, None]
            for pfd in pad_mt:
                pad_mt[pfd]["dist"] = None
            was_on = mode
        if not mode:
            acc = [0.0, 0.0]
            continue
        if time.time() - last_send < 0.016 or (proc and proc.poll() is None):
            continue
        dx, dy = acc
        if mode == "canvas" and not NIRI and not rel_hold:
            p = cursor()
            if p and last_cur:
                dx, dy = p[0] - last_cur[0], p[1] - last_cur[1]
            last_cur = p
        else:
            acc = [0.0, 0.0]
        sp = max(0.1, min(5.0, c["speed"]))
        idx, idy = int(dx * sp), int(dy * sp)
        if rel_hold:
            acc = [dx - idx / sp, dy - idy / sp]
        lim = 160
        cx, cy = max(-lim, min(lim, idx)), max(-lim, min(lim, idy))
        if rel_hold and (cx != idx or cy != idy):
            acc[0] += (idx - cx) / sp
            acc[1] += (idy - cy) / sp
        idx, idy = cx, cy
        if not idx and not idy:
            continue
        moved_rel = False
        sign = -1 if int(c["dir"]) == 2 else 1
        if NIRI:
            niri_slide(idx * sign, idy * sign)
            proc = None
        elif mode == "canvas":
            proc = hypr_eval("if RiceInfinite then RiceInfinite.slide(%d, %d) end" % (idx * sign, idy * sign))
        else:
            proc = hypr_eval("if RiceInfinite then RiceInfinite.edge_push(%d, %d) end" % (idx, idy))
        last_send = time.time()


if __name__ == "__main__":
    try:
        main()
    finally:
        try:
            if open(PID).read().strip() == str(os.getpid()):
                os.remove(PID)
        except OSError:
            pass
