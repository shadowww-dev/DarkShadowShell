#!/usr/bin/env python3
"""rice-autostart: start the desktop entries an app put in autostart for itself.

Hyprland and niri start only what their config names. An app that has "Launch at startup" (Mullvad VPN and
most GTK / Electron apps) writes ~/.config/autostart/<app>.desktop and expects the session to run it; nothing
did, so it worked only where the distro happened to run XDG autostart itself. This reads /etc/xdg/autostart and
~/.config/autostart at login, as the XDG autostart spec says (the user's file wins, Hidden and OnlyShowIn
respected), and starts each one.

  rice-autostart            start them
  rice-autostart --list     what would start, and why the others would not
"""
import configparser
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
SKIP = {}


def dirs():
    # the tests (and a distro with another place) can point it somewhere else
    env = os.environ.get("RICE_AUTOSTART_DIRS")
    if env:
        return [d for d in env.split(":") if d]
    return ["/etc/xdg/autostart", HOME + "/.config/autostart"]


def desktop_names():
    v = os.environ.get("XDG_CURRENT_DESKTOP", "")
    if not v:
        v = "niri" if os.environ.get("NIRI_SOCKET") else "Hyprland"
    return [x.strip().lower() for x in v.split(":") if x.strip()]


def entries():
    """{file name: path}: the system's first, the user's later file with the same name wins"""
    out = {}
    for d in dirs():
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for n in names:
            if n.endswith(".desktop"):
                out[n] = os.path.join(d, n)
    return [out[k] for k in sorted(out)]


def read(path):
    c = configparser.ConfigParser(interpolation=None, strict=False, delimiters=("=",))
    c.optionxform = str
    try:
        c.read(path, encoding="utf-8")
    except (OSError, configparser.Error):
        return None
    return c


def entry(path):
    """(command, delay) to run, or None; the reason goes into SKIP[path]"""
    c = read(path)
    if c is None or not c.has_section("Desktop Entry"):
        SKIP[path] = "not a desktop entry"
        return None
    s = "Desktop Entry"
    def get(k, d=""):
        return (c.get(s, k, fallback=d, raw=True) or "").strip()
    def yes(k, d=True):
        v = get(k, "true" if d else "false").lower()
        return v not in ("false", "0", "no", "off")
    if yes("Hidden", False):
        SKIP[path] = "hidden"
        return None
    if not yes("X-GNOME-Autostart-enabled", True):
        SKIP[path] = "turned off"
        return None
    here = desktop_names()
    only = [x.strip().lower() for x in get("OnlyShowIn").split(";") if x.strip()]
    if only and not [x for x in only if x in here]:
        SKIP[path] = "only for " + ", ".join(only)
        return None
    not_here = [x.strip().lower() for x in get("NotShowIn").split(";") if x.strip()]
    if [x for x in not_here if x in here]:
        SKIP[path] = "not for " + ", ".join(not_here)
        return None
    cmd = get("Exec")
    if not cmd:
        SKIP[path] = "no command"
        return None
    # field codes (%f, %U ...) are for a file manager opening a file: an autostart has none
    cmd = re.sub(r"%[fFuUdDnNickvm]", "", cmd).strip()
    tryexec = get("TryExec")
    if tryexec and shutil.which(tryexec) is None:
        SKIP[path] = "not installed (" + tryexec + ")"
        return None
    try:
        delay = max(0, int(get("X-GNOME-Autostart-Delay", "0") or 0))
    except ValueError:
        delay = 0
    return (delay, cmd)


def main(argv):
    if "--list" in argv:
        for p in entries():
            e = entry(p)
            print("%s\t%s" % (p, "run" if e else "skip: " + SKIP.get(p, "")))
        return 0
    for p in entries():
        e = entry(p)
        if not e:
            continue
        delay, cmd = e
        if delay:
            cmd = "sleep %d; %s" % (delay, cmd)
        try:
            subprocess.Popen(["sh", "-c", cmd], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))